+    schemaVersion: 1,
+    ticket: TICKET,
+    batchId,
+    collection: batch.collection,
+    plannedItemIds: [...batch.itemIds],
+    planFingerprint: digest(Buffer.from(stable(plannedItems)), 'sha256'),
+    createdAt: now,
+    updatedAt: now,
+    attempts: [],
