+      bytes: hosted.bytes.length,
+      status: hosted.status,
+      contentType: hosted.contentType,
+      metadata: hosted.metadata,
+    },
+    source: {
+      sha256: source.sha256 ?? digest(source.bytes),
+      bytes: source.bytes.length,
+      metadata: source.metadata,
+    },
