+  assert.equal(await loads.homeLoad, 'home-ready');
+}
+
+{
+  const firstPaint = deferred();
+  const home = deferred();
+  const loads = startHomeBundles({
+    hostname: 'staging.eatacid.xyz',
+    logger: createLogger(),
+    importModule(specifier) {
+      return specifier.endsWith('/first-paint.js')
